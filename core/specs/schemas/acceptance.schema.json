{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance.schema.json",
  "title": "Desktop Overlay Assistant acceptance criteria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "category",
        "verification",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{3,}$"
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "category": {
          "type": "string",
          "enum": [
            "functional",
            "non_functional",
            "performance",
            "usability",
            "reliability",
            "compatibility"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "unit",
            "integration",
            "windows_e2e",
            "performance",
            "inspection"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
