{
  "schema_version": 1,
  "enabled": true,
  "mode": "observe",
  "required_for_done": false,
  "required_for_qa_approval": false,
  "retain_latest_jobs": 20,
  "targets": [
    {
      "id": "local",
      "type": "local",
      "platform": "linux",
      "enabled": true,
      "capabilities": ["local-command"],
      "allowed_command_templates": [
        {
          "id": "python-version",
          "description": "Muestra la version de Python disponible.",
          "command": ["python3", "--version"],
          "timeout_seconds": 30
        },
        {
          "id": "pytest-quick",
          "description": "Ejecuta los tests rapidos del proyecto.",
          "command": ["uv", "run", "pytest", "-q"],
          "timeout_seconds": 300
        }
      ]
    },
    {
      "id": "manual-drop",
      "type": "manual-drop",
      "platform": "external",
      "enabled": true,
      "capabilities": ["manual-result"]
    },
    {
      "id": "ssh-example",
      "type": "ssh",
      "platform": "linux",
      "enabled": false,
      "host": "example.invalid",
      "user": "agent",
      "port": 22,
      "capabilities": ["ssh-command", "scp-artifact"]
    }
  ]
}
