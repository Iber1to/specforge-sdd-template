{
  "schema_version": 1,
  "enabled": true,
  "mode": "observe",
  "required_for_done": false,
  "required_for_qa_approval": false,
  "retain_latest_jobs": 20,
  "targets": [
    {
      "id": "local",
      "type": "local",
      "platform": "linux",
      "enabled": true,
      "capabilities": ["local-command"]
    },
    {
      "id": "manual-drop",
      "type": "manual-drop",
      "platform": "external",
      "enabled": true,
      "capabilities": ["manual-result"]
    },
    {
      "id": "ssh-example",
      "type": "ssh",
      "platform": "linux",
      "enabled": false,
      "host": "example.invalid",
      "user": "agent",
      "port": 22,
      "capabilities": ["ssh-command", "scp-artifact"]
    }
  ]
}
