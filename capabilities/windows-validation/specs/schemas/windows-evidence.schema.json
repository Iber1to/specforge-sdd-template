{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "windows-evidence.schema.json",
  "title": "Agentic SDD Windows test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "runner_id",
    "host",
    "status",
    "tested_commit",
    "started_at",
    "completed_at",
    "checks",
    "log",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "runner_id": {
      "type": "string",
      "minLength": 3
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "tested_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "started_at": {
      "type": "string",
      "minLength": 10
    },
    "completed_at": {
      "type": "string",
      "minLength": 10
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "log": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean"
        ]
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WIN-[0-9]{3,}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
